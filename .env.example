# ============================================================
# Nexus – Environment Variables (Template)
# ============================================================
# Kopieer dit bestand naar `.env` en vul de waarden in.
# Let op: `.env` bevat secrets en wordt NIET naar Git gepusht.
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
# Formaat: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# Productie: Gebruik een sterke gebruiker/wachtwoord en vermijd `postgres` superuser.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nexus?schema=public"

# ------------------------------------------------------------
# Auth.js (NextAuth V5)
# ------------------------------------------------------------
# Genereer een AUTH_SECRET via: `openssl rand -hex 32` of `npx auth secret`.
AUTH_SECRET="vervang-met-een-32-byte-hex-string"

# Basis-URL voor Auth.js callbacks (optioneel in development; noodzakelijk in productie).
# Pas de poort aan als je Next.js op een andere poort draait (bv. 3001).
AUTH_URL="http://localhost:3000/api/auth"

# Zet op `true` als je app achter een reverse proxy staat (bv. Caddy, Nginx, Vercel)
# en je X-Forwarded-Host / X-Forwarded-Proto headers vertrouwt.
AUTH_TRUST_HOST="false"

# ------------------------------------------------------------
# Next.js
# ------------------------------------------------------------
# Publieke basis-URL van de applicatie (gebruikt in e-mails, links, etc.).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment: development | production | test
NODE_ENV="development"

# ------------------------------------------------------------
# Inserve Integratie
# ------------------------------------------------------------
# Inserve subdomein (het gedeelte voor .inserve.nl in je account-URL).
# Voorbeeld: als je inlogt op https://jouwbedrijf.inserve.nl, is dit "jouwbedrijf".
INSERVE_SUBDOMAIN=""

# (Optioneel) Publieke variant van het Inserve subdomein – nodig voor
# het renderen van externe links naar Inserve in de browser UI.
# Stel deze in op dezelfde waarde als INSERVE_SUBDOMAIN.
NEXT_PUBLIC_INSERVE_SUBDOMAIN=""

# Inserve API key.
# Aanmaken in Inserve: log in → klik rechtsboven op je profielmenu →
# "API instellingen" → nieuwe API key aanmaken en kopiëren.
# Let op: bewaar deze key goed – hij wordt eenmalig getoond.
INSERVE_API_KEY=""

# ------------------------------------------------------------
# Simhuis Integratie (SIM-voorraad + verbruiksdata)
# ------------------------------------------------------------
# Basis-URL voor Simhuis reseller API (default v3).
SIMHUIS_BASE_URL="https://apicontrolcenter.com/v3"

# Auth-mode:
#   basic  = HTTP Basic Auth met username:password (SIMHUIS_USERNAME / SIMHUIS_PASSWORD)
#   bearer = Eerst inloggen via SIMHUIS_ENDPOINT_LOGIN → JWT token → Authorization: Bearer
SIMHUIS_AUTH_MODE="basic"

# Reseller credentials.
SIMHUIS_USERNAME=""
SIMHUIS_PASSWORD=""

# Jouw Simhuis Reseller ID (meestal in het Simhuis dashboard te vinden).
SIMHUIS_RESELLER_ID=""

# ------------------------------------------------------------
# Sync / Automatisch Ophalen (systemd timers ⇄ Next.js Bearer auth)
# ------------------------------------------------------------
# Deze token wordt gedeeld tussen:
#   - De host-systemd sync-scripts (/opt/stm/scripts/sync-*.sh), die hem meesturen
#     als Authorization: Bearer header in de POST naar /api/integrations/.../sync.
#   - De Next.js-app (binnen of buiten Docker), die hem valideert in de 3 sync-routes.
#
# Genereer 1x per installatie, bijvoorbeeld via:
#   openssl rand -hex 32
#
# Handmatig testen (vanaf host, na installatie):
#   curl -X POST -H "Authorization: Bearer <HIER_DEZE_TOKEN>" \
#        http://127.0.0.1:3000/api/integrations/simhuis/sync-usage
SIMHUIS_SYNC_API_TOKEN=""

# (Optioneel) URL waarop de host de draaiende Next.js-app bereikt.
# STandaard: STM_APP_URL=http://127.0.0.1:3000. Alleen aanpassen als de app
# op een andere poort of host draait dan de timers.
STM_APP_URL="http://127.0.0.1:3000"

# ------------------------------------------------------------
# Navixy Integratie (GPS Trackers)
# ------------------------------------------------------------
# Basis-URL Navixy EU-panel.
NAVIXY_BASE_URL="https://api.eu.navixy.com/v2"

# Auth-mode: panel | user | direct
NAVIXY_AUTH_MODE="panel"

# Panel / User credentials of bestaande session hash.
NAVIXY_PANEL_LOGIN=""
NAVIXY_PANEL_PASSWORD=""
NAVIXY_USER_LOGIN=""
NAVIXY_USER_PASSWORD=""
NAVIXY_SESSION_HASH=""

# Defaults bij aanmaken nieuwe trackers.
NAVIXY_DEFAULT_USER_ID=""
NAVIXY_DEFAULT_TARIFF_ID=""
