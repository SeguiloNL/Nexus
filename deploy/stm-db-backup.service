# ============================================================
# systemd: STM PostgreSQL backup service
# Geeft aanroep naar /opt/stm/scripts/backup-stm-db.sh
# Deployed door deploy-stm.sh (cfr. scripts/deploy-stm.sh)
#
# Install:
#   cp deploy/stm-db-backup.service /etc/systemd/system/stm-db-backup.service
#   cp deploy/stm-db-backup.timer   /etc/systemd/system/stm-db-backup.timer
#   systemctl daemon-reload
#   systemctl enable --now stm-db-backup.timer
#   # Run onmiddellijk testen:
#   systemctl start stm-db-backup.service
# ============================================================
[Unit]
Description=STM PostgreSQL Database Backup (daily custom pg_dump)
Documentation=https://github.com/local/stm
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/stm
Environment=TZ=Europe/Amsterdam
EnvironmentFile=-/opt/stm/.env
ExecStart=/bin/bash -c './scripts/backup-stm-db.sh'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stm-db-backup
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/stm /var/lib/postgresql /var/run/postgresql /var/log/stm-install /tmp
ProtectHome=tmpfs
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
