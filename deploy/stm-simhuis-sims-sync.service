# ============================================================
# systemd: STM Simhuis SIM-voorraad Sync (4x per dag)
# Roept scripts/sync-simhuis-sims.sh aan in /opt/stm.
# ============================================================
[Unit]
Description=STM Simhuis SIM-voorraad Sync (4x per dag: nieuwe/bijgewerkte SIMs in Simhuis bijwerken in DB)
Documentation=https://github.com/SeguiloNL/Nexus/
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/stm
Environment=TZ=Europe/Amsterdam
EnvironmentFile=-/opt/stm/.env
ExecStart=/bin/bash -c './scripts/sync-simhuis-sims.sh'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stm-simhuis-sims-sync
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/stm /var/log/stm-install /tmp
ProtectHome=tmpfs
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
