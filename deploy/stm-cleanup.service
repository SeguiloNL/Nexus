# ============================================================
# systemd: STM Cleanup service (wekelijks zondag 04:00)
# Roept scripts/cleanup-stm.sh aan in /opt/stm.
# ============================================================
[Unit]
Description=STM Wekelijkse Cleanup (audit logs, install logs, docker images)
Documentation=https://github.com/SeguiloNL/Nexus/
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/stm
Environment=TZ=Europe/Amsterdam
EnvironmentFile=-/opt/stm/.env
ExecStart=/bin/bash -c './scripts/cleanup-stm.sh'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stm-cleanup
TimeoutStartSec=45min
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Security hardening (minder streng: moet Docker socket aanroepen)
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/stm /var/log/stm-install /var/run/docker.sock /tmp
ProtectHome=tmpfs
PrivateTmp=true
RestrictSUIDSGID=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
