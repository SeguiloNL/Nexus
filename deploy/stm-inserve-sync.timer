# ============================================================
# STM Inserve Sync timer: ELKE 15 MINUTEN
# (Schedule Guard in de app bepaalt of de run WERKELIJK mag
# plaatsvinden op basis van de ADMIN-configuratie; Persistent=true
# zodat gemiste runs alsnog uitgevoerd worden zodra de VPS online komt.)
# ============================================================
[Unit]
Description=Elke 15 minuten Inserve sync (abonnementen + facturen; Schedule Guard in app)
Documentation=https://github.com/SeguiloNL/Nexus/

[Timer]
OnCalendar=*-*-* *:00,15,30,45:00 Europe/Amsterdam
Persistent=true
RandomizedDelaySec=180
AccuracySec=1min
Unit=stm-inserve-sync.service

[Install]
WantedBy=timers.target
