# ============================================================
# STM Health Check timer: ELKE 5 MINUTEN
# /api/health, containers, schijfruimte monitoren
# ============================================================
[Unit]
Description=Elke 5 minuten: STM health check watchdog
Documentation=https://github.com/SeguiloNL/Nexus/

[Timer]
OnCalendar=*:0/5
Persistent=true
AccuracySec=15s
Unit=stm-healthcheck.service

[Install]
WantedBy=timers.target
