// Prisma schema voor Nexus - Activation & Subscription Manager
// Zie .trae/specs/spec.md §3 voor volledige documentatie

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------
// Enums
// ------------------------------

enum UserRole {
  ADMIN
  EMPLOYEE
  VIEWER
}

enum RoleScope {
  INTERNAL
  CUSTOMER
  RESELLER
  PARTNER
}

enum CustomerType {
  DIRECT
  RESELLER
  PARTNER
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SubscriptionStatus {
  DRAFT
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  CANCELLED
  TERMINATED
}

enum TrackerStatus {
  IN_STOCK
  RESERVED
  ACTIVE
  SUSPENDED
  DEFECTIVE
  RMA
  RETIRED
  LOST
}

enum SimStatus {
  IN_STOCK
  RESERVED
  ACTIVE
  SUSPENDED
  BLOCKED
  CANCELLED
  RETIRED
}

enum ActivationOrderStatus {
  DRAFT
  READY
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AssignmentReason {
  INITIAL
  REPLACEMENT
  REMOVED
  RMA
  UPGRADE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  HARD_DELETE
  ACTIVATE
  SUSPEND
  RESUME
  CANCEL
  TERMINATE
  ASSIGN_TRACKER
  UNASSIGN_TRACKER
  ASSIGN_SIM
  UNASSIGN_SIM
  REPLACE_TRACKER
  REPLACE_SIM
  COMPLETE_ACTIVATION
  FAIL_ACTIVATION
  INSERVE_SYNCED
  INSERVE_SYNC_FAILED
  GENERATE_INVOICES
  MARK_INVOICE_PAID
  SEND_INVOICE
  UPDATE_SETTINGS
  BATCH_CREATE
  BATCH_UPDATE
  BATCH_ERROR
  SIMHUIS_SYNCED
  SIMHUIS_SYNC_FAILED
  CLONE_ROLE
  LINK_USER_CUSTOMER
  UNLINK_USER_CUSTOMER
  TOGGLE_USER_ACTIVE
  BULK_UPDATE_ROLE
}

enum InserveSyncStatus {
  PENDING
  IN_PROGRESS
  SYNCED
  FAILED
  SKIPPED
}

enum SyncFrequency {
  EVERY_15_MINUTES
  EVERY_30_MINUTES
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
  TIMEOUT
}

enum SyncJobTrigger {
  MANUAL_ADMIN
  SYSTEMD_TIMER
  FALLBACK_POLLING
  API_TOKEN
}

enum SyncJobId {
  SIMHUIS_USAGE
  SIMHUIS_SIMS
  INSERVE
  SIMHUIS_USAGE_ALERT_NOTIFY
}

enum NotificationChannel {
  EMAIL
}

enum AlertThresholdLevel {
  WARNING_70
  WARNING_80
  WARNING_90
  CRITICAL_100
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ------------------------------
// Models
// ------------------------------

model Role {
  id              String           @id @default(cuid())
  name            String
  scope           RoleScope
  isSystem        Boolean          @default(false)
  isDefault       Boolean          @default(false)
  description     String?          @db.Text
  actionOverrides Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  permissions     RolePermission[]
  users           User[]

  @@unique([name, scope])
  @@index([scope])
  @@map("roles")
}

model RolePermission {
  id       String   @id @default(cuid())
  roleId   String
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  read     Boolean  @default(false)
  write    Boolean  @default(false)

  @@unique([roleId, resource])
  @@index([roleId])
  @@map("role_permissions")
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String
  passwordHash         String
  role                 UserRole       @default(EMPLOYEE)
  roleId               String?
  roleObj              Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  customerId           String?
  customer             Customer?      @relation("CustomerUsers", fields: [customerId], references: [id], onDelete: SetNull)
  isActive             Boolean        @default(true)
  invitationToken      String?
  invitationExpiresAt  DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  auditLogs            AuditLog[]
  customerLinks        UserCustomer[]
  createdActivationOrders ActivationOrder[] @relation("CreatedOrders")
  createdTrackerAssignments TrackerAssignment[] @relation("CreatedTrackers")
  createdSimAssignments     SimAssignment[]     @relation("CreatedSims")
  updatedSyncConfigs       SyncJobConfig[]     @relation("SyncJobConfigUpdatedBy")
  syncJobRuns              SyncJobRun[]        @relation("SyncJobRunTriggeredBy")
  notificationSettings     UserNotificationSettings?
  simUsageAlerts           SimUsageAlert[]
  passwordResetTokens      PasswordResetToken[]

  @@index([roleId])
  @@index([customerId])
  @@index([isActive])
  @@map("users")
}

model Customer {
  id                String     @id @default(cuid())
  customerNumber    String     @unique
  companyName       String
  type              CustomerType @default(DIRECT)
  parentCustomerId  String?
  parentCustomer    Customer?  @relation("CustomerHierarchy", fields: [parentCustomerId], references: [id], onDelete: SetNull)
  subCustomers      Customer[] @relation("CustomerHierarchy")
  billingSubscriptions Subscription[] @relation("BillingCustomer")
  address           String?
  postalCode        String?
  city              String?
  country           String?    @default("NL")
  contactPerson     String?
  phone             String?
  email             String?
  kvkNr             String?
  btwNr             String?
  inserveCompanyId  Int?       @unique
  status            CustomerStatus @default(ACTIVE)
  notes             String?    @db.Text
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  subscriptions     Subscription[]
  vehicles          Vehicle[]
  activationOrders  ActivationOrder[] @relation("CustomerOrders")
  subCustomerOrders ActivationOrder[] @relation("SubCustomerOrders")
  invoices          Invoice[]
  users             User[]           @relation("CustomerUsers")
  userLinks         UserCustomer[]

  @@index([status])
  @@index([parentCustomerId])
  @@index([type])
  @@index([kvkNr])
  @@map("customers")
}

model UserCustomer {
  userId      String
  customerId String
  assignedAt DateTime  @default(now())
  assignedBy String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([userId, customerId])
  @@index([userId])
  @@index([customerId])
  @@map("user_customers")
}

model Product {
  id              String         @id @default(cuid())
  name            String
  productCode     String         @unique
  description     String?        @db.Text
  monthlyPrice    Decimal        @db.Decimal(10, 2)
  currency        String         @default("EUR") @db.VarChar(3)
  btwPercentage   Decimal?       @db.Decimal(4, 2) @default(21)
  isActive        Boolean        @default(true)
  inserveArticleId Int?          @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subscriptions    Subscription[]
  activationOrders ActivationOrder[]

  @@map("products")
}

model Subscription {
  id                   String              @id @default(cuid())
  subscriptionNumber   String              @unique
  customerId           String
  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  billingCustomerId    String?
  billingCustomer      Customer?           @relation("BillingCustomer", fields: [billingCustomerId], references: [id], onDelete: SetNull)
  productId            String
  product              Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  startDate            DateTime            @db.Date
  endDate              DateTime?           @db.Date
  status               SubscriptionStatus  @default(DRAFT)
  monthlyPrice         Decimal             @db.Decimal(10, 2)
  billingCycle         BillingCycle        @default(MONTHLY)
  inserveSyncStatus    InserveSyncStatus   @default(PENDING)
  inserveSyncError     String?             @db.Text
  inserveSubscriptionId Int?               @unique
  inserveLastSyncedAt  DateTime?
  notes                String?             @db.Text
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  trackerAssignments TrackerAssignment[]
  simAssignments     SimAssignment[]
  activationOrders   ActivationOrder[]
  invoices           Invoice[]

  @@index([customerId])
  @@index([billingCustomerId])
  @@index([productId])
  @@index([status])
  @@index([inserveSyncStatus])
  @@map("subscriptions")
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  subscriptionId   String
  subscription     Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  periodStart      DateTime      @db.Date
  periodEnd        DateTime      @db.Date
  issueDate        DateTime      @db.Date
  dueDate          DateTime      @db.Date
  subtotal         Decimal       @db.Decimal(10, 2)
  vatRate          Decimal       @db.Decimal(5, 2)
  vatAmount        Decimal       @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  status           InvoiceStatus     @default(DRAFT)
  sentAt           DateTime?         @db.Timestamptz
  paidAt           DateTime?         @db.Timestamptz
  note             String?           @db.Text
  inserveInvoiceId Int?              @unique
  inserveSyncStatus InserveSyncStatus @default(PENDING)
  inserveSyncError String?           @db.Text
  sentToInserveAt  DateTime?         @db.Timestamptz
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([subscriptionId, periodStart, periodEnd], map: "idx_invoice_sub_period_unique")
  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@index([inserveSyncStatus])
  @@map("invoices")
}

model Tracker {
  id              String        @id @default(cuid())
  serialNumber    String        @unique
  imei            String        @unique @db.VarChar(15)
  brand           String
  model           String
  hardwareType    String?
  firmwareVersion String?
  purchaseDate    DateTime?     @db.Date
  supplier        String?
  status          TrackerStatus @default(IN_STOCK)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  assignments       TrackerAssignment[]
  activationOrders  ActivationOrder[]

  @@index([status])
  @@index([brand, model])
  @@map("trackers")
}

model SIM {
  id                       String    @id @default(cuid())
  iccid                    String    @unique @db.VarChar(40)
  eid                      String?   @unique @db.VarChar(40)
  msisdn                   String?   @unique @db.VarChar(30)
  imsi                     String?   @db.VarChar(20)
  subscriberId             String?   @db.VarChar(100)
  simName                  String?   @db.VarChar(200)
  simGroup                 String?   @db.VarChar(100)
  product                  String?   @db.VarChar(200)
  productType              String?   @db.VarChar(150)
  provider                 String    @db.VarChar(150)
  simType                  String?   @db.VarChar(100)
  apn                      String?   @db.VarChar(200)
  status                   SimStatus @default(IN_STOCK)
  providerActivationDate   DateTime? @db.Date
  providerDeactivationDate DateTime? @db.Date
  activationDate           DateTime? @db.Timestamptz
  reactivationDate         DateTime? @db.Timestamptz
  subscriptionDate         DateTime? @db.Timestamptz
  dataUsedBytes            BigInt?
  dataLimitBytes           BigInt?
  lowestDataLimitBytes     BigInt?
  smsUsedCount             Int?
  smsLimitCount            Int?
  lowestSmsLimitCount      Int?
  lastUsageSyncAt          DateTime?
  usageSource              String?   @db.VarChar(30)
  usageBundleId            String?   @db.VarChar(200)
  usageLocalProductId      String?   @db.VarChar(200)
  usageLocalProductName    String?   @db.VarChar(300)
  usagePeriodStart         DateTime? @db.Timestamptz
  usagePeriodEnd           DateTime? @db.Timestamptz
  usageRetrievedAt         DateTime? @db.Timestamptz
  usageCdrQueryStart       DateTime? @db.Timestamptz
  usageCdrQueryEnd         DateTime? @db.Timestamptz
  usageBundleUsages        Json?
  usageSelectionNote       String?   @db.Text
  notes                    String?   @db.Text
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  assignments       SimAssignment[]
  activationOrders  ActivationOrder[]
  usageAlerts       SimUsageAlert[]

  @@index([status])
  @@index([provider])
  @@map("sims")
}

model Vehicle {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  licensePlate String?  @unique
  vin         String?   @unique @db.VarChar(17)
  brand       String?
  model       String?
  description String?   @db.Text
  notes       String?   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  trackerAssignments TrackerAssignment[]
  activationOrders   ActivationOrder[]

  @@index([customerId])
  @@map("vehicles")
}

model TrackerAssignment {
  id             String            @id @default(cuid())
  subscriptionId String
  subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  trackerId      String
  tracker        Tracker           @relation(fields: [trackerId], references: [id], onDelete: Restrict)
  vehicleId      String?
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  startAt        DateTime          @db.Timestamptz
  endAt          DateTime?         @db.Timestamptz
  reason         AssignmentReason?
  createdById    String?
  createdBy      User?             @relation("CreatedTrackers", fields: [createdById], references: [id], onDelete: SetNull)

  // Opmerking: Een tracker kan maximaal 1 ACTIVE assignment hebben (endAt IS NULL)
  // Deze partial unique unique index wordt aangemaakt via raw SQL in de init migration
  @@index([subscriptionId])
  @@index([trackerId])
  @@index([vehicleId])
  @@map("tracker_assignments")
}

model SimAssignment {
  id             String            @id @default(cuid())
  subscriptionId String
  subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  simId          String
  sim            SIM               @relation(fields: [simId], references: [id], onDelete: Restrict)
  startAt        DateTime          @db.Timestamptz
  endAt          DateTime?         @db.Timestamptz
  reason         AssignmentReason?
  createdById    String?
  createdBy      User?             @relation("CreatedSims", fields: [createdById], references: [id], onDelete: SetNull)

  // Opmerking: Een SIM kan maximaal 1 ACTIVE assignment hebben (endAt IS NULL)
  // Deze partial unique unique index wordt aangemaakt via raw SQL in de init migration
  @@index([subscriptionId])
  @@index([simId])
  @@map("sim_assignments")
}

model ActivationOrder {
  id                 String                 @id @default(cuid())
  orderNumber        String                 @unique
  customerId         String
  customer           Customer               @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  subCustomerId      String?
  subCustomer        Customer?              @relation("SubCustomerOrders", fields: [subCustomerId], references: [id], onDelete: SetNull)
  productId          String
  product            Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  subscriptionId     String?
  subscription       Subscription?          @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  trackerId          String?
  tracker            Tracker?               @relation(fields: [trackerId], references: [id], onDelete: SetNull)
  simId              String?
  sim                SIM?                   @relation(fields: [simId], references: [id], onDelete: SetNull)
  vehicleId          String?
  vehicle            Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  desiredStartDate   DateTime               @db.Date
  monthlyPrice       Decimal                @db.Decimal(10, 2)
  billingCycle       BillingCycle           @default(MONTHLY)
  status             ActivationOrderStatus  @default(DRAFT)
  internalNotes      String?                @db.Text
  failureReason      String?                @db.Text
  failedAt           DateTime?              @db.Timestamptz
  completedAt        DateTime?              @db.Timestamptz
  createdById        String?
  createdBy          User?                  @relation("CreatedOrders", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([customerId])
  @@index([subCustomerId])
  @@index([productId])
  @@index([subscriptionId])
  @@index([status])
  @@index([trackerId])
  @@index([simId])
  @@map("activation_orders")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?  @db.Text
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("app_settings")
}

model SyncJobConfig {
  id             String        @id @default(cuid())
  jobId          SyncJobId     @unique
  enabled        Boolean       @default(true)
  frequency      SyncFrequency @default(DAILY)
  hour           Int           @default(3)
  minute         Int           @default(0)
  dayOfWeek      Int?          @default(1)
  dayOfMonth     Int?          @default(1)
  timezone       String        @default("Europe/Amsterdam")
  updatedById    String?
  updatedBy      User?         @relation("SyncJobConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  lastAppliedAt  DateTime?     @db.Timestamptz
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())

  runs           SyncJobRun[]

  @@index([enabled])
  @@map("sync_job_configs")
}

model SyncJobRun {
  id                String         @id @default(cuid())
  configId          String
  config            SyncJobConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)
  jobId             SyncJobId
  triggeredBy       SyncJobTrigger
  startedAt         DateTime       @default(now()) @db.Timestamptz
  endedAt           DateTime?      @db.Timestamptz
  status            SyncJobStatus  @default(QUEUED)
  durationMs        Int?
  recordsAffected   Json?
  errorMessage      String?        @db.Text
  errorDetail       Json?
  userId            String?
  user              User?          @relation("SyncJobRunTriggeredBy", fields: [userId], references: [id], onDelete: SetNull)

  @@index([jobId, startedAt(sort: Desc)])
  @@index([configId, startedAt(sort: Desc)])
  @@index([status])
  @@index([triggeredBy])
  @@map("sync_job_runs")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  timestamp  DateTime    @default(now()) @db.Timestamptz
  entityType String
  entityId   String
  action     AuditAction
  oldValues  Json?
  newValues  Json?
  metadata   Json?

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

model UserNotificationSettings {
  id                              String                @id @default(cuid())
  userId                          String                @unique
  user                            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabledEmail                    Boolean               @default(true)
  enabledDataThresholdAlert       Boolean               @default(true)
  dataThresholdPercent            Int                   @default(80)
  thresholdLevels                 AlertThresholdLevel[]
  usageAlertCheckIntervalMinutes  Int                   @default(60)
  notifyAllSims                   Boolean               @default(false)
  channels                        NotificationChannel[]
  lastNotificationAt              DateTime?             @db.Timestamptz
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt

  @@index([userId])
  @@map("user_notification_settings")
}

model SimUsageAlert {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  simId             String
  sim               SIM                 @relation(fields: [simId], references: [id], onDelete: Cascade)
  thresholdLevel    AlertThresholdLevel
  dataUsedBytes     BigInt
  dataLimitBytes    BigInt
  usagePeriodStart  DateTime?           @db.Timestamptz
  channel           NotificationChannel
  sentAt            DateTime            @default(now()) @db.Timestamptz

  @@unique([userId, simId, thresholdLevel, usagePeriodStart])
  @@index([userId, sentAt(sort: Desc)])
  @@index([simId])
  @@map("sim_usage_alerts")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz
  usedAt     DateTime? @db.Timestamptz
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
