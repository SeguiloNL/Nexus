# ============================================================
# Nexus - Production Environment Template
# ============================================================
# Kopieer dit bestand naar .env en vul de waarden in, of laat
# ./scripts/setup-env.sh dit automatisch genereren.
# ============================================================

# ------------------------------------------------------------
# --- Nexus App ---
# ------------------------------------------------------------
# Publieke URL van de applicatie (gebruikt door Next.js en Auth)
# Voorbeeld: https://nexus.jouwdomein.nl
NEXT_PUBLIC_APP_URL=

# Node environment
NODE_ENV=production

# ------------------------------------------------------------
# --- Authentication (Auth.js V5) ---
# ------------------------------------------------------------
# Minimaal 32 chars. Genereer met:  openssl rand -hex 32
AUTH_SECRET=

# Auth base URL (doet normaal gesproken overeen met NEXT_PUBLIC_APP_URL + /api/auth)
# Laat leeg om automatisch van NEXT_PUBLIC_APP_URL af te leiden.
AUTH_URL=

# ------------------------------------------------------------
# --- Database (PostgreSQL) ---
# ------------------------------------------------------------
POSTGRES_DB=nexus
POSTGRES_USER=nexus
# Genereer met:  openssl rand -base64 24 | tr -d '\n'
POSTGRES_PASSWORD=

# Full connection string (wordt opgebouwd uit bovenstaande vars in docker-compose,
# maar kan hier expliciet worden overschreven.
# DATABASE_URL=postgresql://nexus:<PASSWORD>@nexus-db:5432/nexus?schema=public

# ------------------------------------------------------------
# --- Reverse Proxy (Caddy) ---
# ------------------------------------------------------------
# Je publieke domein (voor automatic HTTPS via Let's Encrypt).
# Laat leeg / "localhost" voor lokale test zonder TLS.
NEXUS_DOMAIN=

# ------------------------------------------------------------
# --- Inserve Integratie ---
# ------------------------------------------------------------
# Inserve subdomein (het gedeelte voor .inserve.nl in je account-URL).
# Voorbeeld: als je inlogt op https://jouwbedrijf.inserve.nl, is dit "jouwbedrijf".
INSERVE_SUBDOMAIN=

# Inserve API key.
# Aanmaken in Inserve: log in → klik rechtsboven op je profielmenu →
# "API instellingen" → nieuwe API key aanmaken en kopiëren.
# Let op: bewaar deze key goed – hij wordt eenmalig getoond.
INSERVE_API_KEY=
