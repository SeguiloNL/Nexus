# ============================================================
# STM — Production Environment Template
# (voorheen Nexus, project hernoemd)
# ============================================================
# Kopieer dit bestand naar .env EN VUL DE WAARDEN IN:
#   cp .env.production.example .env
#   nano .env
# OF gebruik de setup wizard:
#   bash scripts/setup-env.sh
# ============================================================

# ------------------------------------------------------------
# --- STM App (Algemeen) ---
# ------------------------------------------------------------
# Publieke URL van de applicatie (GEEN localhost / poort 3001 in productie).
# Voorbeeld: https://stm.jouwdomein.nl
# Wordt gebruikt door Next.js (server actions, images, auth callbacks).
NEXT_PUBLIC_APP_URL=

# Node environment
NODE_ENV=production

# Tijdzone (Belangrijk voor datum- en tijdweergave in facturen)
TZ=Europe/Amsterdam

# ------------------------------------------------------------
# --- Authentication (Auth.js V5) ---
# ------------------------------------------------------------
# Minimaal 32 tekens. Genereer met:  openssl rand -hex 32
# NIET delen, NIET committen.
AUTH_SECRET=

# Auth base URL (komt normaal gesproken overeen met NEXT_PUBLIC_APP_URL + /api/auth).
# Laat LEEG om automatisch van NEXT_PUBLIC_APP_URL af te leiden.
AUTH_URL=

# VERPLICHT voor productie i.c.m. Caddy reverse proxy.
# Auth.js moet de X-Forwarded-Host / X-Forwarded-Proto headers van Caddy vertrouwen.
# Anders: CallbackRouteError bij inloggen.
AUTH_TRUST_HOST=true

# ------------------------------------------------------------
# --- Database (PostgreSQL 16 via docker-compose.prod.yml) ---
# ------------------------------------------------------------
POSTGRES_DB=stm
POSTGRES_USER=stm

# Sterk wachtwoord. Genereer met:
#   openssl rand -base64 24 | tr -d '\n'
POSTGRES_PASSWORD=

# Full connection string (wordt AUTOMATISCH opgebouwd in docker-compose
# uit bovenstaande vars; expliciet overschrijven is optioneel).
# Formaat:
#   postgresql://stm:<PASSWORD>@stm-db:5432/stm?schema=public
# DATABASE_URL=

# ------------------------------------------------------------
# --- Reverse Proxy (Caddy: Let's Encrypt HTTPS) ---
# ------------------------------------------------------------
# Je publieke domein (bv. stm.jouwdomein.nl). Laat LEEG of vul "localhost"
# in voor lokale test zonder TLS.
# Caddy vraagt automatisch Let's Encrypt-certificaat aan zodra dit een echt
# domein is met correcte A/AAAA-record naar de VPS.
STM_DOMAIN=

# (Compatibiliteit oude Nexus-installaties: Caddyfile accepteert NEXUS_DOMAIN ook)
NEXUS_DOMAIN=${STM_DOMAIN:-}

# Interne backend host+port van de Next.js app.
#  - docker-compose.prod.yml  (default):  stm-app:3000
#  - Caddy direct op HOST (zonder Caddy-container):  127.0.0.1:3000
# Laat leeg voor default.
# STM_APP_URL=

# ------------------------------------------------------------
# --- Inserve Integratie (Factuur & Abonnement Sync) ---
# ------------------------------------------------------------
# Inserve subdomein (het gedeelte voor .inserve.nl in je account-URL).
# Voorbeeld: als je inlogt op https://jouwbedrijf.inserve.nl  →  "jouwbedrijf"
INSERVE_SUBDOMAIN=

# (Optioneel) PUBLIEKE variant van het Inserve subdomein — nodig voor
# de externe links "Open Inserve ↗" in de UI.
# Vul DEZELFDE waarde in als INSERVE_SUBDOMAIN.
NEXT_PUBLIC_INSERVE_SUBDOMAIN=

# Inserve API key.
# Aanmaken in Inserve:
#   1. Inloggen in Inserve
#   2. Menu rechtsboven profiel → API instellingen → Nieuwe API key
#   3. Kopieer de key (WORDT SLECHTS 1x GETOOND)
INSERVE_API_KEY=

# ------------------------------------------------------------
# --- Simhuis Integratie (SIM Activatie / Status) ---
# Gebruikersnaam + wachtwoord auth (zie Simhuis Control Center
# inlog, Swagger UI is beveiligd met dezelfde credentials).
# ------------------------------------------------------------
# Basis URL van Simhuis Control Center API v3:
#   productie:  https://apicontrolcenter.com/v3
#   (of stuur zelf je toegewezen subdomein toe, ontvangen wij van Simhuis)
SIMHUIS_BASE_URL=https://apicontrolcenter.com/v3

# Auth-methode:
#   basic  = HTTP Basic Auth met username:password (SIMHUIS_USERNAME / SIMHUIS_PASSWORD)
#   bearer = Eerst inloggen via SIMHUIS_ENDPOINT_LOGIN → JWT token → Authorization: Bearer
SIMHUIS_AUTH_MODE=basic

# Simhuis Control Center inloggegevens (NIET committen, NIET delen)
SIMHUIS_USERNAME=
SIMHUIS_PASSWORD=

# (Optioneel) Reseller / partner ID indien Simhuis die hanteert
# (wordt meestal in de request body meegestuurd bij activatie)
SIMHUIS_RESELLER_ID=

# ------------------------------------------------------------
# Simhuis — Configureerbare endpoints (Alleen aanpassen als
# jullie in de Swagger UI (na inloggen) zien dat Simhuis andere
# paths gebruikt dan de standaard v3 patroon)
# ------------------------------------------------------------
# Login endpoint (wordt alleen gebruikt bij SIMHUIS_AUTH_MODE=bearer)
SIMHUIS_ENDPOINT_LOGIN=/auth/login
# Basis-pad voor SIM kaarten operaties (geen leading slash in resource)
SIMHUIS_ENDPOINT_SIMS=/sims
# Sub-endpoints (worden ge-append na SIMHUIS_ENDPOINT_SIMS/{iccid})
SIMHUIS_ENDPOINT_SIM_ACTIVATE=/activate
SIMHUIS_ENDPOINT_SIM_DEACTIVATE=/deactivate

# ------------------------------------------------------------
# --- Navixy Integratie (Tracker Registratie / Status) ---
# Navixy SaaS (Europa, Azië, VS) — Kies JOUW regional base URL!
#   Europa    : https://api.eu.navixy.com/v2     (meest gebruikt in NL)
#   Amerika   : https://api.us.navixy.com/v2
#   Azië/Pac. : https://api.asia.navixy.com/v2
#   Eigen host: https://jouw-navixy-domein.nl/v2
# ------------------------------------------------------------
NAVIXY_BASE_URL=https://api.eu.navixy.com/v2

# Auth-methode Navixy:
#   panel   = Gebruik Admin Panel API inlog (NAVIXY_PANEL_LOGIN + PASSWORD) → sessie hash
#   user    = Gebruik Platform/User API inlog (NAVIXY_USER_LOGIN + PASSWORD)
#   direct  = Gebruik een bestaande sessie-hash direct (NAVIXY_SESSION_HASH)
NAVIXY_AUTH_MODE=panel

# Bij NAVIXY_AUTH_MODE=panel (Admin Panel, dealer-level toegang):
#   Login = Numerieke Panel ID (te vinden in Navixy → Profiel / Account info)
NAVIXY_PANEL_LOGIN=
NAVIXY_PANEL_PASSWORD=

# Bij NAVIXY_AUTH_MODE=user (Platform API, user-level):
NAVIXY_USER_LOGIN=
NAVIXY_USER_PASSWORD=

# Bij NAVIXY_AUTH_MODE=direct:
# (Wordt gebruikt om stap login over te slaan)
NAVIXY_SESSION_HASH=

# (Optioneel, aanbevolen) Default Navixy Gebruiker-ID.
# Nieuwe trackers worden standaard aan deze Navixy gebruiker gekoppeld.
# (Kan per Activation Order worden overschreven door een custom veld)
NAVIXY_DEFAULT_USER_ID=

# (Optioneel) Default Service Plan / Tariff ID.
# Wordt meegegeven bij tracker registratie (indien ingesteld).
NAVIXY_DEFAULT_TARIFF_ID=

# ------------------------------------------------------------
# Navixy — Configureerbare endpoints (Alleen aanpassen als
# Navixy documentatie / jouw instantie andere paths gebruikt)
# ------------------------------------------------------------
# (Worden gerelatieve URLs, ge-append na NAVIXY_BASE_URL)
NAVIXY_ENDPOINT_PANEL_AUTH=/panel/account/auth
NAVIXY_ENDPOINT_USER_AUTH=/user/session/auth
# Basis-pad tracker operaties (Panel API)
NAVIXY_ENDPOINT_PANEL_TRACKER=/panel/tracker
# Basis-pad tracker operaties (Platform/User API)
NAVIXY_ENDPOINT_USER_TRACKER=/user/tracker
# Handshake check: "ping" endpoint of /user/settings, optioneel
# NAVIXY_ENDPOINT_PING=/

