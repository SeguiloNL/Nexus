# ============================================================
# STM — Production Environment Template
# (voorheen Nexus, project hernoemd)
# ============================================================
# Kopieer dit bestand naar .env EN VUL DE WAARDEN IN:
#   cp .env.production.example .env
#   nano .env
# OF gebruik de setup wizard:
#   bash scripts/setup-env.sh
# ============================================================

# ------------------------------------------------------------
# --- STM App (Algemeen) ---
# ------------------------------------------------------------
# Publieke URL van de applicatie (GEEN localhost / poort 3001 in productie).
# Voorbeeld: https://stm.jouwdomein.nl
# Wordt gebruikt door Next.js (server actions, images, auth callbacks).
NEXT_PUBLIC_APP_URL=

# Node environment
NODE_ENV=production

# Tijdzone (Belangrijk voor datum- en tijdweergave in facturen)
TZ=Europe/Amsterdam

# ------------------------------------------------------------
# --- Authentication (Auth.js V5) ---
# ------------------------------------------------------------
# Minimaal 32 tekens. Genereer met:  openssl rand -hex 32
# NIET delen, NIET committen.
AUTH_SECRET=

# Auth base URL (komt normaal gesproken overeen met NEXT_PUBLIC_APP_URL + /api/auth).
# Laat LEEG om automatisch van NEXT_PUBLIC_APP_URL af te leiden.
AUTH_URL=

# VERPLICHT voor productie i.c.m. Caddy reverse proxy.
# Auth.js moet de X-Forwarded-Host / X-Forwarded-Proto headers van Caddy vertrouwen.
# Anders: CallbackRouteError bij inloggen.
AUTH_TRUST_HOST=true

# ------------------------------------------------------------
# --- Database (PostgreSQL 16 via docker-compose.prod.yml) ---
# ------------------------------------------------------------
POSTGRES_DB=stm
POSTGRES_USER=stm

# Sterk wachtwoord. Genereer met:
#   openssl rand -base64 24 | tr -d '\n'
POSTGRES_PASSWORD=

# Full connection string (wordt AUTOMATISCH opgebouwd in docker-compose
# uit bovenstaande vars; expliciet overschrijven is optioneel).
# Formaat:
#   postgresql://stm:<PASSWORD>@stm-db:5432/stm?schema=public
# DATABASE_URL=

# ------------------------------------------------------------
# --- Reverse Proxy (Caddy: Let's Encrypt HTTPS) ---
# ------------------------------------------------------------
# Je publieke domein (bv. stm.jouwdomein.nl). Laat LEEG of vul "localhost"
# in voor lokale test zonder TLS.
# Caddy vraagt automatisch Let's Encrypt-certificaat aan zodra dit een echt
# domein is met correcte A/AAAA-record naar de VPS.
STM_DOMAIN=

# (Compatibiliteit oude Nexus-installaties: Caddyfile accepteert NEXUS_DOMAIN ook)
NEXUS_DOMAIN=${STM_DOMAIN:-}

# Interne backend host+port van de Next.js app.
#  - docker-compose.prod.yml  (default):  stm-app:3000
#  - Caddy direct op HOST (zonder Caddy-container):  127.0.0.1:3000
# Laat leeg voor default.
# STM_APP_URL=

# ------------------------------------------------------------
# --- Inserve Integratie (Factuur & Abonnement Sync) ---
# ------------------------------------------------------------
# Inserve subdomein (het gedeelte voor .inserve.nl in je account-URL).
# Voorbeeld: als je inlogt op https://jouwbedrijf.inserve.nl  →  "jouwbedrijf"
INSERVE_SUBDOMAIN=

# (Optioneel) PUBLIEKE variant van het Inserve subdomein — nodig voor
# de externe links "Open Inserve ↗" in de UI.
# Vul DEZELFDE waarde in als INSERVE_SUBDOMAIN.
NEXT_PUBLIC_INSERVE_SUBDOMAIN=

# Inserve API key.
# Aanmaken in Inserve:
#   1. Inloggen in Inserve
#   2. Menu rechtsboven profiel → API instellingen → Nieuwe API key
#   3. Kopieer de key (WORDT SLECHTS 1x GETOOND)
INSERVE_API_KEY=

# ------------------------------------------------------------
# --- Simhuis Integratie (SIM Activatie / Status) ---
# Gebruikersnaam + wachtwoord auth (zie Simhuis Control Center
# inlog, Swagger UI is beveiligd met dezelfde credentials).
# ------------------------------------------------------------
# Basis URL van Simhuis Control Center API v3:
#   productie:  https://apicontrolcenter.com/v3
#   (of stuur zelf je toegewezen subdomein toe, ontvangen wij van Simhuis)
SIMHUIS_BASE_URL=https://apicontrolcenter.com/v3

# Auth-methode:
#   basic  = HTTP Basic Auth met username:password (SIMHUIS_USERNAME / SIMHUIS_PASSWORD)
#   bearer = Eerst inloggen via SIMHUIS_ENDPOINT_LOGIN → JWT token → Authorization: Bearer
SIMHUIS_AUTH_MODE=basic

# Simhuis Control Center inloggegevens (NIET committen, NIET delen)
SIMHUIS_USERNAME=
SIMHUIS_PASSWORD=

# (Optioneel) Reseller / partner ID indien Simhuis die hanteert
# (wordt meestal in de request body meegestuurd bij activatie)
SIMHUIS_RESELLER_ID=

# ------------------------------------------------------------
# Simhuis — Configureerbare endpoints (Alleen aanpassen als
# jullie in de Swagger UI (na inloggen) zien dat Simhuis andere
# paths gebruikt dan de standaard v3 patroon)
# ------------------------------------------------------------
# Login endpoint (wordt alleen gebruikt bij SIMHUIS_AUTH_MODE=bearer)
SIMHUIS_ENDPOINT_LOGIN=/auth/login
# Basis-pad voor SIM kaarten operaties (geen leading slash in resource)
SIMHUIS_ENDPOINT_SIMS=/sims
# Sub-endpoints (worden ge-append na SIMHUIS_ENDPOINT_SIMS/{iccid})
SIMHUIS_ENDPOINT_SIM_ACTIVATE=/activate
SIMHUIS_ENDPOINT_SIM_DEACTIVATE=/deactivate

# ------------------------------------------------------------
# Simhuis — Uurlijkse Usage / Data / SMS Sync (periodiek)
# ------------------------------------------------------------
# API-token die de SIM-sync API-routes beschermen. ZET DEZE EN
# HOUD HEM GEHEIM. Wordt zowel gebruikt door de volledige
# "simkaart voorraad sync" als door de snelle "usage sync"
# (uurlijks via systemd timer stm-simhuis-usage-sync.timer).
#
# Genereer met:   openssl rand -base64 32 | tr -d '\n'
#
# Handmatig aanroepen (voor test):
#   curl -X POST -H "Authorization: Bearer <HIER_DEZE_TOKEN>" \
#        https://stm.jouwdomein.nl/api/integrations/simhuis/sync-usage
#
# Automatisch installeren op VPS (na deploy):
#   systemctl enable --now stm-simhuis-usage-sync.timer
SIMHUIS_SYNC_API_TOKEN=

# ------------------------------------------------------------
# --- Navixy Integratie (Tracker Registratie / Status) ---
# Navixy SaaS (Europa, Azië, VS) — Kies JOUW regional base URL!
#   Europa    : https://api.eu.navixy.com/v2     (meest gebruikt in NL)
#   Amerika   : https://api.us.navixy.com/v2
#   Azië/Pac. : https://api.asia.navixy.com/v2
#   Eigen host: https://jouw-navixy-domein.nl/v2
# ------------------------------------------------------------
NAVIXY_BASE_URL=https://api.eu.navixy.com/v2

# Auth-methode Navixy:
#   panel   = Gebruik Admin Panel API inlog (NAVIXY_PANEL_LOGIN + PASSWORD) → sessie hash
#   user    = Gebruik Platform/User API inlog (NAVIXY_USER_LOGIN + PASSWORD)
#   direct  = Gebruik een bestaande sessie-hash direct (NAVIXY_SESSION_HASH)
NAVIXY_AUTH_MODE=panel

# Bij NAVIXY_AUTH_MODE=panel (Admin Panel, dealer-level toegang):
#   Login = Numerieke Panel ID (te vinden in Navixy → Profiel / Account info)
NAVIXY_PANEL_LOGIN=
NAVIXY_PANEL_PASSWORD=

# Bij NAVIXY_AUTH_MODE=user (Platform API, user-level):
NAVIXY_USER_LOGIN=
NAVIXY_USER_PASSWORD=

# Bij NAVIXY_AUTH_MODE=direct:
# (Wordt gebruikt om stap login over te slaan)
NAVIXY_SESSION_HASH=

# (Optioneel, aanbevolen) Default Navixy Gebruiker-ID.
# Nieuwe trackers worden standaard aan deze Navixy gebruiker gekoppeld.
# (Kan per Activation Order worden overschreven door een custom veld)
NAVIXY_DEFAULT_USER_ID=

# (Optioneel) Default Service Plan / Tariff ID.
# Wordt meegegeven bij tracker registratie (indien ingesteld).
NAVIXY_DEFAULT_TARIFF_ID=

# ------------------------------------------------------------
# Navixy — Configureerbare endpoints (Alleen aanpassen als
# Navixy documentatie / jouw instantie andere paths gebruikt)
# ------------------------------------------------------------
# (Worden gerelatieve URLs, ge-append na NAVIXY_BASE_URL)
NAVIXY_ENDPOINT_PANEL_AUTH=/panel/account/auth
NAVIXY_ENDPOINT_USER_AUTH=/user/session/auth
# Basis-pad tracker operaties (Panel API)
NAVIXY_ENDPOINT_PANEL_TRACKER=/panel/tracker
# Basis-pad tracker operaties (Platform/User API)
NAVIXY_ENDPOINT_USER_TRACKER=/user/tracker
# Handshake check: "ping" endpoint of /user/settings, optioneel
# NAVIXY_ENDPOINT_PING=/

# ------------------------------------------------------------
# --- SMTP / E-mail Notificaties ---
# ------------------------------------------------------------
# Wordt gebruikt voor drempel-notificaties (SIM-data 80%, etc.).
# Kan ook worden ingesteld in het beheer (Instellingen > Notificaties).
# Als omgevingsvariabelen zijn ingesteld hebben ze VOORRANG op de database.

# Hostnaam + poort (doorgaans 587 = STARTTLS, 465 = SSL/TLS)
SMTP_HOST=
SMTP_PORT=587

# "true" voor impliciete SSL/TLS (poort 465). Niet aanvinken voor STARTTLS.
SMTP_SECURE=false

# SMTP authenticatie (optioneel).
SMTP_USER=
SMTP_PASSWORD=

# Standaard afzender, bv. "norepy@jouwdomein.nl"
SMTP_FROM=noreply@nexus.local

# =====================================================================
# --- Modulair SIM-kaart Leverancierssysteem (Providers Framework) ---
# =====================================================================
# NIEUW (sinds Nexus 2026.10): meerdere simkaart-leveranciers via
# een gedeeld adapter-framework. Bestaande Simhuis-configuratie
# BLIJFT 100% ONGEWIJZIGD en BLIJFT DE DEFAULT.
#
# Uitleg:
#   * Iedere leverancier heeft eigen <PROVIDERKEY>_ voorvoegsel (UPPERCASE).
#   * AppSettings (in de DB) en omgevingsvariabelen (hier) werken BOTH:
#     omgevingswaarden hebben voorrang INDIEN gezet.
#   * Gevoelige velden (password / secret / token / key) worden AUTOMATISCH
#     als geheim opgeslagen in AppSetting (isSecret=true) en zijn in de
#     beheer-UI alleen gemaskeerd zichtbaar (laatste 4 tekens).
#   * De beheer-UI /admin/providers is de primaire plek om een provider
#     te activeren en te configureren (ook als env vars ontbreken).
#   * Nieuwe providers: voeg het <PROVIDERKEY>_... patroon toe, registreer
#     de adapter in src/server/providers/registry.ts, zie handleiding:
#       docs/adding-a-sim-provider.md
# =====================================================================

# ---------------------------------------------------------------------
# Provider: SIMHUIS  (bestaande, altijd backward-compat sectie, DEZE
#                    BESTAAT AL. Hieronder herhaal voor de duidelijkheid,
#                    en AANVULLEND: defaults voor de NIEUWE AppSetting
#                    plat-sleutels simhuis.*  (ze worden OOK via deze
#                    env vars gelezen indien aanwezig).
# ---------------------------------------------------------------------
SIMHUIS_BASE_URL=https://apicontrolcenter.com/v3
SIMHUIS_AUTH_MODE=basic                  # basic | bearer | api_token | oauth_client_credentials
SIMHUIS_USERNAME=
SIMHUIS_PASSWORD=
SIMHUIS_API_TOKEN=                       # (optioneel, bij auth_mode=api_token)
SIMHUIS_CLIENT_ID=                       # (optioneel, bij oauth)
SIMHUIS_CLIENT_SECRET=                   # (optioneel, bij oauth)
SIMHUIS_WEBHOOK_SECRET=                  # (optioneel, voor inkomende webhooks)
SIMHUIS_RESELLER_ID=                     # (optioneel, partner/reseller ID)
SIMHUIS_DEFAULTS_DEFAULT_OFFER_ID=       # (optioneel, default aanbieding)
SIMHUIS_DEFAULTS_DEFAULT_PLAN_ID=        # (optioneel, default plan)
SIMHUIS_DEFAULTS_DEFAULT_PRODUCT_NAME=   # (optioneel, weergavenaam)
# Simhuis endpoints (bestaande sectie BLIJFT; hier voor compatibiliteit
# OOK met het nieuwe "endpoint.*" AppSetting sub-sleutel patroon):
SIMHUIS_ENDPOINT_LOGIN=/auth/login
SIMHUIS_ENDPOINT_SIMS=/sims
SIMHUIS_ENDPOINT_SIM_ACTIVATE=/activate
SIMHUIS_ENDPOINT_SIM_DEACTIVATE=/deactivate

# ---------------------------------------------------------------------
# Provider: MOCK  (test-only / voorbeeldadapter. NIET gebruiken in
#                 productie. Heeft tot doel te laten zien hoe een tweede
#                 provider wordt toegevoegd ZONDER wijziging in Simhuis.)
#                 Wordt ALLEEN in het registry getoond indien
#                 NODE_ENV !== 'production' of handmatig geactiveerd.
# ---------------------------------------------------------------------
# MOCK_BASE_URL=https://mock-provider.example.com/v1
# MOCK_AUTH_MODE=api_token                 # basic | password | api_token | oauth_client_credentials
# MOCK_USERNAME=
# MOCK_PASSWORD=
# MOCK_API_TOKEN=
# MOCK_CLIENT_ID=
# MOCK_CLIENT_SECRET=
# MOCK_WEBHOOK_SECRET=
# MOCK_RESELLER_ID=
# MOCK_DEFAULTS_DEFAULT_OFFER_ID=
# MOCK_DEFAULTS_DEFAULT_PLAN_ID=
# MOCK_DEFAULTS_DEFAULT_PRODUCT_NAME=
# # Mock optionele endpoints (laat leeg om defaults te gebruiken):
# MOCK_ENDPOINT_LIST_SIMS=/sims
# MOCK_ENDPOINT_GET_SIM=
# MOCK_ENDPOINT_ACTIVATE=/sims/activate
# MOCK_ENDPOINT_DEACTIVATE=/sims/deactivate
# MOCK_ENDPOINT_SUSPEND=
# MOCK_ENDPOINT_UNSUSPEND=
# MOCK_ENDPOINT_SUBSCRIBE=
# MOCK_ENDPOINT_PURGE=

# ---------------------------------------------------------------------
# NIEUWE PROVIDERS TOEVOEGEN?  (sjabloon — kopieer & vul in)
# ---------------------------------------------------------------------
# Vervang JOUWPROVIDER door de providerKey (klein, URL-safe).
# De exacte namen van env vars lees je in docs/adding-a-sim-provider.md
# en in src/server/services/app-setting.service.ts -> resolveProviderEnv()
# (patroon: UPPERCASE_PROVIDERKEY_SUBKEY, wordt automatisch gemapt naar
# de platgeslagen AppSetting keys "jouwprovider.baseUrl" enz.).
#
# # ------ (KOPIEER VANAF HIER) ------
# # --- Basis + authenticatie ---
# JOUWPROVIDER_BASE_URL=
# JOUWPROVIDER_AUTH_MODE=password          # password | api_token | oauth_client_credentials
# JOUWPROVIDER_USERNAME=
# JOUWPROVIDER_PASSWORD=
# JOUWPROVIDER_API_TOKEN=
# JOUWPROVIDER_CLIENT_ID=
# JOUWPROVIDER_CLIENT_SECRET=
# JOUWPROVIDER_WEBHOOK_SECRET=
# JOUWPROVIDER_RESELLER_ID=
#
# # --- Defaults producten ---
# JOUWPROVIDER_DEFAULTS_DEFAULT_OFFER_ID=
# JOUWPROVIDER_DEFAULTS_DEFAULT_PLAN_ID=
# JOUWPROVIDER_DEFAULTS_DEFAULT_PRODUCT_NAME=
#
# # --- Optionele endpoints (alleen aanpassen als nodig) ---
# # subkeys: listSims | getSim | activate | deactivate | suspend | unsuspend |
# #          subscribe | precheck | getAsset | purge | usage | testConnection
# JOUWPROVIDER_ENDPOINT_LIST_SIMS=
# JOUWPROVIDER_ENDPOINT_ACTIVATE=
# JOUWPROVIDER_ENDPOINT_DEACTIVATE=
# JOUWPROVIDER_ENDPOINT_SUSPEND=
# JOUWPROVIDER_ENDPOINT_UNSUSPEND=
# JOUWPROVIDER_ENDPOINT_SUBSCRIBE=
# JOUWPROVIDER_ENDPOINT_PURGE=
# JOUWPROVIDER_ENDPOINT_USAGE=
# # ------ (TOT HIER) ------

